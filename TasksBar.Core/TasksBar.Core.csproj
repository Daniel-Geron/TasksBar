<Project Sdk="Microsoft.NET.Sdk">

  <!-- Everything TasksBar does that isn't UI: settings, local data, Google Tasks / CalDAV sync and
       sticky note sync. Shared by the Windows (WPF) app and the Linux (Avalonia) app. -->
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>TasksBar</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Apis.Auth" Version="1.73.0" />
    <PackageReference Include="Google.Apis.Tasks.v1" Version="1.72.0.3958" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
