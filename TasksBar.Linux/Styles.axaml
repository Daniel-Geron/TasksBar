<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Matches WPF-UI's "Transparent" buttons: no chrome until hovered -->
    <Style Selector="Button.flat">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="Cursor" Value="Arrow"/>
    </Style>
    <Style Selector="Button.flat:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.flat:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="Button.flat:pressed">
        <Setter Property="RenderTransform" Value="none"/>
    </Style>

    <!-- Task title/details: borderless text with a faint underline that turns accent while editing,
         like the Windows app's WPF-UI text boxes -->
    <Style Selector="TextBox.task">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextUnderlineBrush}"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="CaretBrush" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        <Setter Property="VerticalContentAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBox.task /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextUnderlineBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="CornerRadius" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
    </Style>
    <Style Selector="TextBox.task:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource TextUnderlineBrush}"/>
    </Style>
    <Style Selector="TextBox.task:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,2"/>
    </Style>
    <Style Selector="TextBox.task:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
    </Style>
    <Style Selector="TextBox.task /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>
    <Style Selector="TextBox.task:focus /template/ TextBlock#PART_Watermark">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
    </Style>
    <Style Selector="TextBox.details">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBox.details:focus">
        <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
    </Style>

    <!-- Menus on the accent-tinted Windows 11 look -->
    <Style Selector="ContextMenu">
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Background" Value="{DynamicResource MenuBackgroundBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource SurfaceStrokeColorDefaultBrush}"/>
    </Style>
</Styles>
