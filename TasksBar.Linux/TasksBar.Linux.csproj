<Project Sdk="Microsoft.NET.Sdk">

  <!-- TasksBar for Linux (Ubuntu GNOME, KDE Plasma). Same features and data as the Windows app,
       with the UI rebuilt in Avalonia; all sync and data logic comes from TasksBar.Core. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <RootNamespace>TasksBar.Linux</RootNamespace>
    <AssemblyName>tasksbar</AssemblyName>
    <BuiltInComInteropSupport>false</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\TasksBar\tasksbar.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="11.3.23" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.23" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="11.3.23" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="11.3.23" />
    <PackageReference Include="FluentIcons.Avalonia" Version="1.1.312" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TasksBar.Core\TasksBar.Core.csproj" />
  </ItemGroup>

</Project>
