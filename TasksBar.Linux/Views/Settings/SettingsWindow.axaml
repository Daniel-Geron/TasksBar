<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ic="using:FluentIcons.Avalonia"
        x:Class="TasksBar.Linux.Views.Settings.SettingsWindow"
        Title="Settings" Width="800" Height="600" MinWidth="560" MinHeight="400"
        SystemDecorations="None" CanResize="True" Topmost="True"
        Background="Transparent" TransparencyLevelHint="AcrylicBlur, Blur, Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="fonts:Inter#Inter, $Default"
        Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <Window.Styles>
        <!-- Settings rows (SettingsCard), like WPF-UI's cards -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="MinHeight" Value="68"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style Selector="Border.card:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="Border.card.clickable">
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="28"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,24"/>
        </Style>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>

        <!-- Switches without the "On"/"Off" words, like Windows 11 -->
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value=""/>
            <Setter Property="OffContent" Value=""/>
            <Setter Property="MinWidth" Value="0"/>
        </Style>

        <!-- Sidebar -->
        <Style Selector="ListBox#SidebarList">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="ListBox#SidebarList ListBoxItem">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
            <Setter Property="CornerRadius" Value="4"/>
        </Style>
        <Style Selector="ListBox#SidebarList ListBoxItem /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox#SidebarList ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox#SidebarList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox#SidebarList ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
        </Style>

        <!-- Title bar buttons, like Windows 11's caption buttons -->
        <Style Selector="Button.caption">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.caption:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="Button.caption.close:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#C42B1C"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.caption:pressed">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>
    </Window.Styles>

    <Border x:Name="Chrome" CornerRadius="8" BorderThickness="1" ClipToBounds="True"
            BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
        <Panel x:Name="Frame">
            <Grid RowDefinitions="40,*" ColumnDefinitions="220,*">

                <!-- Title bar: drag to move, double-click to maximize -->
                <Grid x:Name="TitleBar" Grid.ColumnSpan="2" Background="Transparent" ColumnDefinitions="*,Auto">
                    <TextBlock Text="Settings" FontSize="12" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Classes="caption" Click="Minimize_Click" ToolTip.Tip="Minimize">
                            <ic:SymbolIcon Symbol="Subtract" FontSize="16" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="caption" Click="Maximize_Click" ToolTip.Tip="Maximize">
                            <ic:SymbolIcon x:Name="MaximizeIcon" Symbol="Maximize" FontSize="16" Width="16" Height="16"/>
                        </Button>
                        <Button Classes="caption close" Click="Close_Click" ToolTip.Tip="Close">
                            <ic:SymbolIcon Symbol="Dismiss" FontSize="16" Width="16" Height="16"/>
                        </Button>
                    </StackPanel>
                </Grid>

                <Border Grid.Row="1" Grid.Column="0" BorderThickness="0,0,1,0" BorderBrush="{DynamicResource SurfaceStrokeColorDefaultBrush}">
                    <ListBox x:Name="SidebarList" Margin="10,20,10,10" SelectionChanged="SidebarList_SelectionChanged">
                        <ListBoxItem>
                            <Panel>
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="PaintBucket" FontSize="24" Width="24" Height="24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Appearance &amp; Layout" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Panel>
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="CloudArrowUp" FontSize="24" Width="24" Height="24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Behavior &amp; Sync" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Panel>
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="Note" FontSize="24" Width="24" Height="24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Sticky Notes" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                        </ListBoxItem>
                        <ListBoxItem>
                            <Panel>
                                <StackPanel Orientation="Horizontal">
                                    <ic:SymbolIcon Symbol="List" FontSize="24" Width="24" Height="24" Margin="0,0,12,0"/>
                                    <TextBlock Text="Lists" FontSize="14" FontWeight="Medium" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Panel>
                        </ListBoxItem>
                    </ListBox>
                </Border>

                <ContentControl x:Name="PageHost" Grid.Row="1" Grid.Column="1"/>
            </Grid>
        </Panel>
    </Border>
</Window>
