<Page x:Class="TasksBar.BehaviorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Behavior &amp; Sync" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" Margin="20,10,20,30">
            <TextBlock Text="Behavior &amp; Sync" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <ui:CardControl Icon="{ui:SymbolIcon CloudArrowUp24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Google Tasks Sync" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Keep tasks synchronized with your Google account" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Content="Log in to Google" Icon="{ui:SymbolIcon Person24}" Margin="0,0,12,0" Click="LoginGoogle_Click"/>
                    <ui:ToggleSwitch x:Name="GoogleSyncToggle" Click="Setting_Changed" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Rocket24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Launch on Startup" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Start TasksBar automatically with Windows" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupToggle" Click="Setting_Changed" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Server24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Stream Deck Integration" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Run the local API server so the Stream Deck plugin can connect" FontSize="12" Opacity="0.5" />
                        <TextBlock Text="(Requires Stream Deck plugin to be installed)" FontSize="12" Opacity="0.5" />
                        <TextBlock>
                         <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"  
                         NavigateUri="https://github.com/Daniel-Geron/TasksBar-Stream-Deck-Plugin/releases/">Get it here!</Hyperlink>
                        </TextBlock>

                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StreamDeckToggle" Click="Setting_Changed" />
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>