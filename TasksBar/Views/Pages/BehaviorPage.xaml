<Page x:Class="TasksBar.BehaviorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Behavior &amp; Sync" Foreground="{DynamicResource TextFillColorPrimaryBrush}">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="800" Margin="20,10,20,30">
            <TextBlock Text="Behavior &amp; Sync" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" />

            <ui:CardControl Icon="{ui:SymbolIcon CloudArrowUp24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Task Sync" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Sync with Google Tasks or Tasks.org" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ComboBox x:Name="SyncProviderBox" MinWidth="200" SelectionChanged="SyncProvider_Changed">
                    <ComboBoxItem Content="Off (this PC only)" Tag="Local"/>
                    <ComboBoxItem Content="Google Tasks" Tag="Google"/>
                    <ComboBoxItem Content="Tasks.org / CalDAV" Tag="CalDav"/>
                </ComboBox>
            </ui:CardControl>

            <!-- Google account -->
            <ui:CardControl x:Name="GooglePanel" Icon="{ui:SymbolIcon Person24}" Margin="0,0,0,4" Visibility="Collapsed">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Google Account" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Sign in once; TasksBar remembers it" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:Button Content="Log in to Google" Icon="{ui:SymbolIcon Person24}" Click="LoginGoogle_Click"/>
            </ui:CardControl>

            <!-- Tasks.org / CalDAV account -->
            <Border x:Name="CalDavPanel" Visibility="Collapsed" Margin="0,0,0,4" Padding="16" CornerRadius="8" BorderThickness="1"
                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="PlugConnected24" FontSize="24" Margin="0,0,16,0" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Tasks.org / CalDAV Account" FontSize="14" FontWeight="Medium"/>
                            <TextBlock x:Name="CalDavStatusText" Text="Not connected" FontSize="12" Opacity="0.5" TextWrapping="Wrap"/>
                        </StackPanel>
                        <ComboBox x:Name="CalDavServerTypeBox" Grid.Column="2" MinWidth="200" VerticalAlignment="Center" SelectionChanged="CalDavServerType_Changed">
                            <ComboBoxItem Content="Tasks.org Cloud"/>
                            <ComboBoxItem Content="Other CalDAV server"/>
                        </ComboBox>
                    </Grid>

                    <TextBlock x:Name="TasksOrgHelpText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12">
                        Needs a Tasks.org subscription with Tasks.org Cloud sync. Create an app password in the Tasks.org app
                        (Settings → your Tasks.org account → App passwords) or at
                        <Hyperlink NavigateUri="https://tasks.org/account" RequestNavigate="Hyperlink_RequestNavigate">tasks.org/account</Hyperlink>,
                        then copy the username and password it shows below. They're only shown once.
                    </TextBlock>
                    <TextBlock x:Name="CalDavHelpText" FontSize="12" Opacity="0.7" TextWrapping="Wrap" Margin="0,0,0,12" Visibility="Collapsed">
                        Works with Nextcloud, Fastmail, iCloud, Radicale and other servers that store tasks over CalDAV.
                        The server address can be the site's root (e.g. https://cloud.example.com) or your CalDAV URL.
                        If your provider offers app passwords, use one here.
                    </TextBlock>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="CalDavServerLabel" Text="Server" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <ui:TextBox x:Name="CalDavServerBox" Grid.Column="1" PlaceholderText="https://cloud.example.com" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="1" Text="Username" VerticalAlignment="Center" Margin="0,0,0,8"/>
                        <ui:TextBox x:Name="CalDavUserBox" Grid.Row="1" Grid.Column="1" PlaceholderText="Username" Margin="0,0,0,8"/>

                        <TextBlock Grid.Row="2" Text="App password" VerticalAlignment="Center"/>
                        <ui:PasswordBox x:Name="CalDavPasswordBox" Grid.Row="2" Grid.Column="1" PlaceholderText="Password"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <ui:Button x:Name="CalDavDisconnectButton" Content="Disconnect" Margin="0,0,8,0" Click="CalDavDisconnect_Click" Visibility="Collapsed"/>
                        <ui:Button x:Name="CalDavConnectButton" Content="Connect" Appearance="Primary" Icon="{ui:SymbolIcon PlugConnected24}" Click="CalDavConnect_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <ui:CardControl Icon="{ui:SymbolIcon Note24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Sync Sticky Notes" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Back up notes to a hidden list in your synced account" FontSize="12" Opacity="0.5" />
                        <TextBlock Text="(Requires Task Sync)" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="NoteSyncToggle" Click="Setting_Changed" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon NoteAdd24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="New Sticky Note Shortcut" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Works from any app" FontSize="12" Opacity="0.5" />
                        <TextBlock x:Name="NewNoteHotkeyStatus" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="NewNoteHotkeyBox" Width="180" IsReadOnly="True" IsReadOnlyCaretVisible="False" ClearButtonEnabled="False"
                                PlaceholderText="Click, then press keys" Tag="NewNote"
                                PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Remove shortcut" Margin="8,0,0,0" Tag="NewNote" Click="ClearHotkey_Click" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon WindowMultiple20}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Open All Sticky Notes Shortcut" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Shows every note on top" FontSize="12" Opacity="0.5" />
                        <TextBlock x:Name="OpenAllNotesHotkeyStatus" FontSize="12" Foreground="{DynamicResource SystemFillColorCriticalBrush}" Visibility="Collapsed" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:TextBox x:Name="OpenAllNotesHotkeyBox" Width="180" IsReadOnly="True" IsReadOnlyCaretVisible="False" ClearButtonEnabled="False"
                                PlaceholderText="Click, then press keys" Tag="OpenAllNotes"
                                PreviewKeyDown="HotkeyBox_PreviewKeyDown" GotKeyboardFocus="HotkeyBox_GotKeyboardFocus" LostKeyboardFocus="HotkeyBox_LostKeyboardFocus" />
                    <ui:Button Icon="{ui:SymbolIcon Dismiss24}" ToolTip="Remove shortcut" Margin="8,0,0,0" Tag="OpenAllNotes" Click="ClearHotkey_Click" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Rocket24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Launch on Startup" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Start TasksBar automatically with Windows" FontSize="12" Opacity="0.5" />
                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StartupToggle" Click="Setting_Changed" />
            </ui:CardControl>
            <ui:CardControl Icon="{ui:SymbolIcon Server24}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Stream Deck Integration" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Run the local API server so the Stream Deck plugin can connect" FontSize="12" Opacity="0.5" />
                        <TextBlock Text="(Requires Stream Deck plugin to be installed)" FontSize="12" Opacity="0.5" />
                        <TextBlock>
                         <Hyperlink RequestNavigate="Hyperlink_RequestNavigate"  
                         NavigateUri="https://github.com/Daniel-Geron/TasksBar-Stream-Deck-Plugin/releases/">Get it here!</Hyperlink>
                        </TextBlock>

                    </StackPanel>
                </ui:CardControl.Header>
                <ui:ToggleSwitch x:Name="StreamDeckToggle" Click="Setting_Changed" />
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Speaker224}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Hover Sound" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Plays when hovering a task's check circle" FontSize="12" Opacity="0.5" />
                        <TextBlock x:Name="HoverSoundFileText" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxWidth="320" HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Preview" Margin="0,0,8,0" Click="PreviewHoverSound_Click" />
                    <ui:Button Content="Choose MP3" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,12,0" Click="BrowseHoverSound_Click" />
                    <ui:ToggleSwitch x:Name="HoverSoundToggle" Click="Setting_Changed" />
                </StackPanel>
            </ui:CardControl>

            <ui:CardControl Icon="{ui:SymbolIcon Speaker224}" Margin="0,0,0,4">
                <ui:CardControl.Header>
                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="Click Sound" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                        <TextBlock Text="Plays when clicking a task's check circle" FontSize="12" Opacity="0.5" />
                        <TextBlock x:Name="ClickSoundFileText" FontSize="12" Opacity="0.5" TextTrimming="CharacterEllipsis" MaxWidth="320" HorizontalAlignment="Left" />
                    </StackPanel>
                </ui:CardControl.Header>
                <StackPanel Orientation="Horizontal">
                    <ui:Button Icon="{ui:SymbolIcon Play24}" ToolTip="Preview" Margin="0,0,8,0" Click="PreviewClickSound_Click" />
                    <ui:Button Content="Choose MP3" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,12,0" Click="BrowseClickSound_Click" />
                    <ui:ToggleSwitch x:Name="ClickSoundToggle" Click="Setting_Changed" />
                </StackPanel>
            </ui:CardControl>

        </StackPanel>
    </ScrollViewer>
</Page>