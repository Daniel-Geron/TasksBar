<Page x:Class="TasksBar.NotesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Sticky Notes">

    <Grid Margin="20,10,20,30" MaxWidth="800">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Manage Notes" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

        <ui:CardControl Grid.Row="1" Icon="{ui:SymbolIcon Rocket24}" Margin="0,0,0,16">
            <ui:CardControl.Header>
                <StackPanel Orientation="Vertical">
                    <TextBlock Text="Open Notes When TasksBar Starts" FontSize="14" FontWeight="Medium" VerticalAlignment="Center" />
                    <TextBlock x:Name="OpenAllSummaryText" FontSize="12" Opacity="0.5" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="OpenAllToggle" Click="OpenAllToggle_Click" />
        </ui:CardControl>

        <ListView x:Name="NotesListView" Grid.Row="2" BorderThickness="0" Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ui:CardControl Margin="0,0,0,8">
                        <ui:CardControl.Header>
                            <StackPanel VerticalAlignment="Center" MaxWidth="400" HorizontalAlignment="Left">
                                <!-- Title: click the pencil (or double-click the title) to rename -->
                                <Grid>
                                    <!-- The title shrinks (with "…") before the rename button is pushed out -->
                                    <Grid x:Name="TitleView" HorizontalAlignment="Left">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DisplayTitle}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="Double-click to rename"
                                                   MouseLeftButtonDown="Title_MouseLeftButtonDown" Tag="{Binding}"/>
                                        <ui:Button Grid.Column="1" Appearance="Transparent" Icon="{ui:SymbolIcon Symbol=Edit16}" Padding="4" Margin="4,0,0,0"
                                                   ToolTip="Rename" VerticalAlignment="Center" Click="RenameNote_Click" Tag="{Binding}"/>
                                    </Grid>
                                    <ui:TextBox x:Name="TitleEditor" Visibility="Collapsed" MinWidth="240" MaxWidth="360" HorizontalAlignment="Left"
                                                PlaceholderText="{Binding DefaultTitle}" ClearButtonEnabled="False" Tag="{Binding}"
                                                KeyDown="TitleEditor_KeyDown" LostKeyboardFocus="TitleEditor_LostKeyboardFocus"/>
                                </Grid>
                                <TextBlock Text="{Binding Preview}" FontSize="12" Opacity="0.6" TextTrimming="CharacterEllipsis" Margin="0,2,0,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <Trigger Property="Text" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Open at startup" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,8,0"/>
                            <ui:ToggleSwitch IsChecked="{Binding OpenOnStartup, Mode=OneWay}" Click="OpenOnStartup_Click" Tag="{Binding}" Margin="0,0,16,0" VerticalAlignment="Center"/>
                            <ui:Button Content="Open" Icon="{ui:SymbolIcon Symbol=Open24}" Margin="0,0,8,0" Click="OpenNote_Click" Tag="{Binding}"/>

                            <ui:Button Icon="{ui:SymbolIcon Symbol=Delete24}" ToolTip="Delete note" Click="DeleteNote_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </ui:CardControl>
                </DataTemplate>
            </ListView.ItemTemplate>

            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Margin" Value="0,0,0,4"/>
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Focusable" Value="False"/>

                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListViewItem">
                                <ContentPresenter />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListView.ItemContainerStyle>
        </ListView>
    </Grid>
</Page>